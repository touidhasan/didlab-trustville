# dependencies
node_modules/

# secrets — never commit
.env
.env.*
!.env.example
*.key
keystore/

# foundry
contracts/out/
contracts/cache/
contracts/lib/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/

# misc
.DS_Store
*.log
.vite/
# NOTE: dist/ is committed on purpose — cPanel publishes it.

# VitePress build output. A gitignore pattern containing a slash is anchored to this
# file's directory, so a bare .vitepress/dist never matched docs/.vitepress/dist.
**/.vitepress/cache/
**/.vitepress/dist/

# Module 16 circuit build. The ptau and intermediate zkeys are large and regenerable;
# scripts/build-circuit.sh copies the three artifacts the app and the verifier need out of
# here, and those ARE committed -- the browser has to fetch them at runtime.
build/circuit/

# Service keys live on the machine that runs the service, never here.
services/*/keys/
*.key.json
