# Which chain the site talks to. With no .env at all it builds for DIDLab, which is what
# the public site at dapp.didlab.org runs.
#
# Copy to app/.env to point a fork somewhere else. `scripts/local-town.sh` writes this
# file for you when it starts a local chain.

# --- a local anvil chain -----------------------------------------------------
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_NAME=Local Trustville
# VITE_CURRENCY_SYMBOL=ETH
# VITE_CURRENCY_NAME=Ether
# VITE_FAUCET_URL=            # empty: anvil accounts are already funded, so hide the step
# VITE_EXPLORER_URL=          # empty: no explorer, so the UI hides those links

# --- your own deployment on DIDLab, or any other EVM chain -------------------
# VITE_CHAIN_ID=252501
# VITE_RPC_URL=https://eth.didlab.org
# VITE_EXPLORER_URL=https://explorer.didlab.org
# VITE_FAUCET_URL=https://faucet.didlab.org
